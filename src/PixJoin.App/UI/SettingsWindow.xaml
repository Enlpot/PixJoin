<Window x:Class="PixJoin.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixJoin 设置"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7"
        ShowInTaskbar="True">
    <DockPanel Margin="14">
        <!-- 底部按钮 -->
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,12,0,0">
            <Button x:Name="BtnSave" Content="保存" Width="120" Height="30" Margin="0,0,10,0"
                    HorizontalAlignment="Right" Click="OnSave" IsDefault="True"/>
            <Button Content="取消" Width="120" Height="30" Margin="10,0,0,0"
                    HorizontalAlignment="Left" Click="OnCancel" IsCancel="True"/>
        </UniformGrid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 快捷键 -->
                <GroupBox Header="快捷键">
                    <StackPanel Margin="8,4">
                        <DockPanel>
                            <Button x:Name="BtnChangeHotkey" DockPanel.Dock="Right" Content="更改…" Width="64"
                                    Margin="8,0,0,0" Click="OnChangeHotkey"/>
                            <TextBox x:Name="TxtHotkey" IsReadOnly="True" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtHotkeyHint" Text="点击「更改…」后按下新的组合键"
                                   Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 吸附与拆分 -->
                <GroupBox Header="吸附与拆分" Margin="0,10,0,0">
                    <StackPanel Margin="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="吸附距离(px)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSnap" Grid.Row="0" Grid.Column="1" Width="56" Height="24"
                                     HorizontalAlignment="Left" Margin="4,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="对齐容差(px)" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtAlign" Grid.Row="0" Grid.Column="3" Width="56" Height="24"
                                     HorizontalAlignment="Left" Margin="4,0" VerticalContentAlignment="Center"/>

                            <TextBlock Text="拆分保护键" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbProtect" Grid.Row="1" Grid.Column="1" Width="76" Height="26"
                                      HorizontalAlignment="Left" Margin="4,8,0,0"/>
                            <TextBlock Text="拆分距离(px)" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox x:Name="TxtDetach" Grid.Row="1" Grid.Column="3" Width="56" Height="24"
                                     HorizontalAlignment="Left" Margin="4,8,0,0" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="保护键：按住保护键再拖动组合内贴图才允许拆离，防止误拆"
                                   Foreground="#888" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 贴图 -->
                <GroupBox Header="贴图" Margin="0,10,0,0">
                    <StackPanel Margin="8,6">
                        <DockPanel Margin="0,2">
                            <TextBlock Text="贴图数量上限" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMax" Width="56" Height="24" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,2">
                            <TextBlock Text="默认透明度" Width="120" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOpacityVal" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="SldOpacity" Minimum="10" Maximum="100" ValueChanged="OnOpacityChanged" VerticalAlignment="Center"/>
                        </DockPanel>
                        <CheckBox x:Name="ChkOutline" Content="显示组合体外框" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 贴图交互 -->
                <GroupBox Header="贴图交互" Margin="0,10,0,0">
                    <StackPanel Margin="8,6">
                        <CheckBox x:Name="ChkDblClick" Content="双击关闭贴图"/>
                        <CheckBox x:Name="ChkWheel" Content="直接滚动滚轮缩放贴图" Margin="0,8,0,0"/>
                        <CheckBox x:Name="ChkEsc" Content="悬停贴图按 ESC 关闭" Margin="0,8,0,0"/>
                        <CheckBox x:Name="ChkOcr" Content="自动识别文字（悬停文字可拖选复制）" Margin="0,8,0,0"/>
                        <TextBlock Text="首次使用仍会弹窗确认，可在本处关闭对应功能"
                                   Foreground="#888" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 导出 -->
                <GroupBox Header="导出" Margin="0,10,0,0">
                    <StackPanel Margin="8,6">
                        <CheckBox x:Name="ChkTransparent" Content="透明背景"/>
                        <CheckBox x:Name="ChkTrim" Content="自动裁剪空白边缘" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 启动 -->
                <GroupBox Header="启动" Margin="0,10,0,0">
                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（写入当前用户启动项）" Margin="8,8"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
