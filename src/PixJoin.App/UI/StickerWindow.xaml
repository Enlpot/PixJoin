<Window x:Class="PixJoin.App.UI.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixJoin Sticker"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="False">

    <Window.Resources>
        <Style x:Key="ResizeHandle" TargetType="Thumb">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Opacity" Value="0.95" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FF00E5C0" Stroke="#FF073B34" StrokeThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <!-- 贴图本体 -->
        <Border x:Name="Frame"
                BorderThickness="1"
                BorderBrush="#00000000"
                SnapsToDevicePixels="True">
            <Image x:Name="Img"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderOptions.EdgeMode="Aliased" />
        </Border>

        <!-- 四角缩放手柄（悬停或已组合时显示） -->
        <Grid x:Name="HandleLayer" Visibility="Collapsed">
            <Thumb x:Name="HandleTL" Style="{StaticResource ResizeHandle}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="-7,-7,0,0" Cursor="SizeNWSE" />
            <Thumb x:Name="HandleTR" Style="{StaticResource ResizeHandle}"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-7,-7,0" Cursor="SizeNESW" />
            <Thumb x:Name="HandleBL" Style="{StaticResource ResizeHandle}"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="-7,0,0,-7" Cursor="SizeNESW" />
            <Thumb x:Name="HandleBR" Style="{StaticResource ResizeHandle}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,-7,-7" Cursor="SizeNWSE" />
        </Grid>

        <!-- 文字选择高亮层（最顶层；空白不拦截，仅高亮矩形绘制） -->
        <Canvas x:Name="OverlayLayer" Visibility="Collapsed">
            <Canvas x:Name="SelectLayer" IsHitTestVisible="False" />
        </Canvas>
    </Grid>
</Window>
