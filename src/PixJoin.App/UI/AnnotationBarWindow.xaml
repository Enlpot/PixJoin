<Window x:Class="PixJoin.App.UI.AnnotationBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标注"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ToolRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorChip" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#88888888"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="#F5FFFFFF" BorderBrush="#AA888888" BorderThickness="1"
            CornerRadius="6" Padding="8,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- 工具 -->
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ToolRect" GroupName="Tools" Content="矩形" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Rect"/>
                <RadioButton x:Name="ToolEllipse" GroupName="Tools" Content="椭圆" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Ellipse"/>
                <RadioButton x:Name="ToolArrow" GroupName="Tools" Content="箭头" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Arrow" IsChecked="True"/>
                <RadioButton x:Name="ToolPen" GroupName="Tools" Content="画笔" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Pen"/>
                <RadioButton x:Name="ToolText" GroupName="Tools" Content="文字" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Text"/>
                <RadioButton x:Name="ToolHighlight" GroupName="Tools" Content="高亮" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Highlight"/>
                <RadioButton x:Name="ToolMosaic" GroupName="Tools" Content="马赛克" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Mosaic"/>
                <RadioButton x:Name="ToolNumber" GroupName="Tools" Content="序号" Style="{StaticResource ToolRadio}"
                             Checked="OnToolChecked" Tag="Number"/>
            </StackPanel>

            <Border Width="1" Background="#CCCCCC" Margin="8,2"/>
            <TextBlock Text="颜色" FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="0,0,4,0"/>

            <!-- 颜色 -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ColorRed" Tag="#E53935" Style="{StaticResource ColorChip}" Background="#E53935" Click="OnColorClicked"/>
                <Button x:Name="ColorOrange" Tag="#FB8C00" Style="{StaticResource ColorChip}" Background="#FB8C00" Click="OnColorClicked"/>
                <Button x:Name="ColorYellow" Tag="#FDD835" Style="{StaticResource ColorChip}" Background="#FDD835" Click="OnColorClicked"/>
                <Button x:Name="ColorGreen" Tag="#43A047" Style="{StaticResource ColorChip}" Background="#43A047" Click="OnColorClicked"/>
                <Button x:Name="ColorBlue" Tag="#1E88E5" Style="{StaticResource ColorChip}" Background="#1E88E5" Click="OnColorClicked"/>
                <Button x:Name="ColorPurple" Tag="#8E24AA" Style="{StaticResource ColorChip}" Background="#8E24AA" Click="OnColorClicked"/>
                <Button x:Name="ColorBlack" Tag="#212121" Style="{StaticResource ColorChip}" Background="#212121" Click="OnColorClicked"/>
                <Button x:Name="ColorWhite" Tag="#FFFFFF" Style="{StaticResource ColorChip}" Background="#FFFFFF" Click="OnColorClicked"/>
            </StackPanel>

            <Border Width="1" Background="#CCCCCC" Margin="8,2"/>
            <TextBlock Text="粗细" FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="0,0,4,0"/>

            <!-- 线宽 -->
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Thin1" GroupName="Thick" Content="细" Style="{StaticResource ToolRadio}" Checked="OnThickChecked" Tag="2"/>
                <RadioButton x:Name="Thin2" GroupName="Thick" Content="中" Style="{StaticResource ToolRadio}" Checked="OnThickChecked" Tag="4" IsChecked="True"/>
                <RadioButton x:Name="Thin3" GroupName="Thick" Content="粗" Style="{StaticResource ToolRadio}" Checked="OnThickChecked" Tag="8"/>
            </StackPanel>

            <Border Width="1" Background="#CCCCCC" Margin="8,2"/>

            <!-- 样式（线型 / 箭头形状） -->
            <Button Content="样式 ▾" Style="{StaticResource ToolButton}" Click="OnStyleMenu"
                    ToolTip="线型 / 箭头形状（作用于新标注与选中标注）"/>

            <Border Width="1" Background="#CCCCCC" Margin="8,2"/>

            <!-- 撤销 / 完成 -->
            <Button Content="撤销" Style="{StaticResource ToolButton}" Click="OnUndo" ToolTip="撤销上一步 (Ctrl+Z)"/>
            <Button Content="✓ 完成" Style="{StaticResource ToolButton}" Background="#EE00A8FF" Foreground="White"
                    Click="OnDone" Margin="6,0,0,0" ToolTip="完成并固化标注 (Esc)"/>
        </StackPanel>
    </Border>
</Window>
