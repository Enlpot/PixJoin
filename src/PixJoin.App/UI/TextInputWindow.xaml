<Window x:Class="PixJoin.App.UI.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入文字" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontSize="13">
    <StackPanel Margin="12,10,12,10">
        <TextBlock Text="输入标注文字，回车确认" Foreground="#666" FontSize="11" Margin="0,0,0,6"/>
        <TextBox x:Name="Input" Width="220" MaxHeight="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 KeyDown="OnKeyDown" AcceptsReturn="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" Width="64" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Width="64" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
